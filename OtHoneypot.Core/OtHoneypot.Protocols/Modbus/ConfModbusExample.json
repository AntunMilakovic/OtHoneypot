{
  "name": "WaterTreatmentSCADA",
  "type": "ModbusTcp",
  "description": "Simulated SCADA Modbus master",
  "enabled": true,

  "role": "Master",

  "bindAddress": "192.168.10.10",
  "port": 502,

  "allowedIPs": [
    "192.168.10.0/24"
  ],

  "devices": [
    {
      "name": "PLC_PumpStation_01",
      "ipAddress": "192.168.10.20",
      "port": 502,
      "unitId": 1,

      "polls": [
        {
          "name": "ProcessValues",
          "registerType": "HoldingRegister",
          "startAddress": 100,
          "count": 10,
          "pollIntervalMs": 1000
        },
        {
          "name": "DigitalInputs",
          "registerType": "DiscreteInput",
          "startAddress": 0,
          "count": 16,
          "pollIntervalMs": 500
        }
      ]
    },

    {
      "name": "PLC_PumpStation_02",
      "ipAddress": "192.168.10.21",
      "port": 502,
      "unitId": 1,

      "polls": [
        {
          "name": "ProcessValues",
          "registerType": "HoldingRegister",
          "startAddress": 0,
          "count": 20,
          "pollIntervalMs": 2000
        }
      ]
    }
  ]
}