{
  "Honeypot": {
    "DataTemplates": [
      {
        "Id": 1,
        "Name": "TankLevel",
        "Description": "Tank level controlled by Modbus commands",
        "DataType": "float",
        "Simulation": {
          "MinValue": 0,
          "MaxValue": 100,
          "RefreshRate": 1,
          "Type": "Dynamic",
          "ValueChangeRate": 2.5
        }
      }
    ],
    "Modbus": [
      {
        "name": "DynamicPLC",
        "type": "ModbusTcp",
        "role": "Slave",
        "enabled": true,
        "bindAddress": "0.0.0.0",
        "port": 502,
        "readingInterval": 250,
        "registers": [
          {
            "name": "TankLevel",
            "type": "InputRegister",
            "address": 100,
            "dataType": "Float32",
            "dataTemplateId": 1,
            "writable": false
          }
        ],
        "commandMappings": [
          {
            "name": "IncreaseTankLevel",
            "registerType": "HoldingRegister",
            "address": 200,
            "value": 1,
            "dataTemplateId": 1,
            "command": "Increase"
          },
          {
            "name": "DecreaseTankLevel",
            "registerType": "HoldingRegister",
            "address": 201,
            "value": 1,
            "dataTemplateId": 1,
            "command": "Decrease"
          },
          {
            "name": "HoldTankLevel",
            "registerType": "HoldingRegister",
            "address": 202,
            "value": 1,
            "dataTemplateId": 1,
            "command": "Hold"
          },
          {
            "name": "ResetTankLevel",
            "registerType": "HoldingRegister",
            "address": 203,
            "value": 1,
            "dataTemplateId": 1,
            "command": "Reset"
          }
        ]
      }
    ]
  }
}
