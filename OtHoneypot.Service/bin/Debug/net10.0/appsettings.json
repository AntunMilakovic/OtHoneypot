{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10000000,
          "rollOnFileSizeLimit": true,
          "retainedFileTimeLimit": "31.00:00:00"
        }
      }
    ]
  },
  "Honeypot": {
    "DataTemplates": [
      {
        "Id": 0,
        "Name": "Adr1",
        "Description": "Temperatura vode",
        "DataType": "float",
        "Simulation": {
          "MinValue": 0,
          "MaxValue": 5,
          "RefreshRate": 15,
          "Type": "RandomWalk",
          "ValueChangeRate": 1
        }
      }
    ],
    "ActiveProtocols": [
      "Modbus"
    ],
    "Protocols": [
      {
        "name": "WaterTreatmentSCADA",
        "type": "ModbusTcp",
        "description": "Simulated SCADA Modbus master",
        "enabled": true,
        "role": "Master",
        "bindAddress": "192.168.10.10",
        "port": 502,
        "allowedIPs": [
          "192.168.10.0/24"
        ],
        "devices": [
          {
            "name": "PLC_PumpStation_01",
            "ipAddress": "192.168.10.20",
            "port": 502,
            "unitId": 1,
            "polls": [
              {
                "name": "ProcessValues",
                "registerType": "HoldingRegister",
                "startAddress": 100,
                "count": 10,
                "pollIntervalMs": 1000
              },
              {
