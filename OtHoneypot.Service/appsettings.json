{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },

  "Honeypot": {
    "DataTemplates": [],
    "Modbus": [
      {
        "name": "FakeSCADA01",
        "type": "ModbusTcp",
        "description": "Simulated SCADA Modbus TCP master",
        "enabled": true,
        "role": "Master",

        "bindAddress": "0.0.0.0",
        "port": 502,

        "allowedIPs": [],

        "devices": [
          {
            "name": "FakePLC01",
            "ipAddress": "192.168.153.4",
            "port": 1502,
            "unitId": 1,
	    "pollIntervalS": 60,

            "Polls": [
              {
                "Name": "ProcessValues",
                "RegisterType": "InputRegister",
                "StartAddress": 100,
                "Count": 4,
                "DataType": "Float32",
                "ByteOrder": "ABCD"
              }
            ],
            "ScheduledWrites": [
              {
                "Name": "StartFilling",
                "RegisterType": "HoldingRegister",
                "Address": 200,
                "Value": 1,
                "InitialDelayS": 30,
                "RepeatEveryS": 600
              },
              {
                "Name": "StopFilling",
                "RegisterType": "HoldingRegister",
                "Address": 200,
                "Value": 3,
                "InitialDelayS": 330,
                "RepeatEveryS": 600
              }
            ]
          }
        ],

        "registers": []
      }
    ]
  }
}