{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },

  "Honeypot": {
    "DataTemplates": [
      {
        "Id": 1,
        "Name": "AirConsumption",
        "Description": "Air consumption",
        "DataType": "float",
        "Simulation": {
          "MinValue": 1000,
          "MaxValue": 1100,
          "RefreshRate": 1000,
          "Type": "RandomWalk",
          "ValueChangeRate": 5
        }
      },
      {
        "Id": 2,
        "Name": "AirPressure",
        "Description": "Air pressure",
        "DataType": "float",
        "Simulation": {
          "MinValue": 8.5,
          "MaxValue": 10.0,
          "RefreshRate": 1000,
          "Type": "RandomWalk",
          "ValueChangeRate": 0.1
        }
      }
    ],
    "Modbus": [
      {
        "name": "FakePLC01",
        "type": "ModbusTcp",
        "description": "Simulated Modbus TCP PLC",
        "enabled": true,
        "role": "Slave",

        "bindAddress": "0.0.0.0",
        "port": 502,

        "allowedIPs": [],

        "devices": [],

        "registers": [
          {
            "name": "AirConsumption",
            "address": 100,
            "type": "InputRegister",
            "dataType": "Float32",
            "dataTemplateId": 1,
            "writable": false
          },
          {
            "name": "AirPressure",
            "address": 102,
            "type": "InputRegister",
            "dataType": "Float32",
            "dataTemplateId": 2,
            "writable": false
          }
        ]
      }
    ]
  }
}